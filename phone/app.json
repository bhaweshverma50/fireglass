{
  "expo": {
    "name": "TV Home Remote",
    "slug": "tv-home-remote",
    "scheme": "tvhomeremote",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B1F",
    "ios": {
      "bundleIdentifier": "dev.bhawesh.tvhomeremote",
      "buildNumber": "2",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Finds your TV on this Wi-Fi network and sends it remote presses.",
        "NSBonjourServices": [
          "_tvhome._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.bhawesh.tvhomeremote",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#070B1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InstrumentSerif-Regular.ttf",
            "./assets/fonts/Figtree-Regular.ttf",
            "./assets/fonts/Figtree-Medium.ttf",
            "./assets/fonts/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick pictures to show on your TV as a background or screensaver.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lets you talk to your TV with the mic button.",
          "speechRecognitionPermission": "Turns what you say into commands for your TV, on this phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#070B1F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "extraProguardRules": "-keep class com.rnllama.** { *; }\n-keep class com.balthazargronon.RCTZeroconf.** { *; }"
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true
        }
      ]
    ]
  }
}
